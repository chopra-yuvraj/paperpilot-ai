{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/upload", "dest": "/api/index.py" },
    { "src": "/ask", "dest": "/api/index.py" },
    { "src": "/explain_text", "dest": "/api/index.py" },
    { "src": "/health", "dest": "/api/index.py" },
    { "src": "/style.css", "dest": "/frontend/style.css" },
    { "src": "/script.js", "dest": "/frontend/script.js" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
